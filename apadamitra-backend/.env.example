ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

MONGO_URI=mongodb+srv://username:password@cluster-name.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=apadamitra

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=StrongAdminPass123
ADMIN_NAME=ApadaMitra Admin
ADMIN_PHONE=+919876543210

GEMINI_API_KEY=your_google_gemini_key
ALERT_THRESHOLD=70

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number

ENABLE_BACKGROUND_ALERTS=true
ALERT_MONITOR_INTERVAL_SECONDS=3600
ALERT_MONITOR_BATCH_LIMIT=100
